# ============================================
# AUTO DEL SOL FIAT CRM — Variables de entorno (frontend)
# Copiar a .env y completar.
# ============================================

# URL del backend, INCLUYENDO el /api al final.
# Ejemplo local:      http://localhost:3001/api
# Ejemplo producción: https://tu-backend.up.railway.app/api
VITE_API_URL=http://localhost:3001/api

# URL del bot de WhatsApp Fiat (Baileys, en el droplet).
# Si no se setea, usa https://api.crmalluma.com.ar/wa-fiat
VITE_WHATSAPP_BOT_URL=https://api.crmalluma.com.ar/wa-fiat
